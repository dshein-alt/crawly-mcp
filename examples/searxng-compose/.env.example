# Copy this file to `.env` and edit as needed. `docker compose` picks up
# `.env` from the current working directory automatically.

# --- Container image ---
# Default: latest tagged release published to GHCR. Override to use a locally
# built image (e.g. `docker build -t crawly-mcp:local .`):
#   CRAWLY_MCP_IMAGE=localhost/crawly-mcp:local
CRAWLY_MCP_IMAGE=ghcr.io/dshein-alt/crawly-mcp:latest

# --- Host port bindings ---
# Crawly's MCP HTTP transport binds to 127.0.0.1; change the compose file
# if you want it reachable from other hosts. SearXNG is reachable only on
# the compose network and is not bound to a host port by default.
CRAWLY_HOST_PORT=10000

# --- Crawly runtime ---
# TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
CRAWLY_LOG_LEVEL=INFO

# Providers are enabled by their presence in this comma-separated priority
# order. Available names: searxng, duckduckgo, google, yandex.
CRAWLY_SEARCH_PROVIDER_ORDER=searxng,duckduckgo,google,yandex

# Hard-disable providers, even when a caller requests one explicitly.
# Exclusion wins over the order above. Leave empty to exclude none.
CRAWLY_SEARCH_PROVIDER_EXCLUDE=

# Maximum providers attempted per search. Set to 1 to disable cascading.
CRAWLY_SEARCH_MAX_PROVIDERS=3
